{
  "name": "onboarding-frame",
  "version": "0.1.0",
  "description": "A UI library of production-grade SaaS onboarding flows: setup wizards, checklists, product tours, feature-spotlight modal sequences, empty states, and paywall sequences. Config-driven, themeable, headless-friendly.",
  "keywords": [
    "onboarding",
    "react",
    "ui",
    "saas",
    "product-tour",
    "checklist",
    "wizard",
    "paywall",
    "pricing",
    "tailwind"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "bin",
    "dist",
    "src",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles.css": "./src/styles.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      },
      "./styles.css": "./src/styles.css",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.47.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "bin": {
    "onboarding-frame": "./bin/onboarding-frame.mjs"
  }
}
